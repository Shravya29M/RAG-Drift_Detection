# At least one LLM key enables generated answers; with none set the API runs
# in keyless mode and returns retrieved context verbatim.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional integrations
WANDB_API_KEY=
DRIFT_WEBHOOK_URL=

# Redis: shared query cache, drift state, incidents, jobs and index version.
# Empty = single-process mode. docker-compose sets it for the replicas.
REDIS_URL=
# true/false; empty keeps config/default.yaml (cache.enabled)
QUERY_CACHE_ENABLED=

# Set to true to skip W&B logging entirely
WANDB_DISABLED=
# Seed the bundled samples/ into an empty index on first boot (default true)
SEED_SAMPLE_DATA=
